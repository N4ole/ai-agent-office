{
  "name": "ai-agent-office",
  "productName": "AI Agent Office",
  "version": "1.3.1",
  "description": "Bureau virtuel pixel art pour superviser vos agents Claude Code en temps réel",
  "main": "dist/main/index.js",
  "author": "AI Agent Office",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "lint:setup": "npm ci --prefix tools/lint --no-audit --no-fund",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "icon": "node scripts/make-icon.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.aiagentoffice.app",
    "productName": "AI Agent Office",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!**/*.map",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm",
      "dist/main/hook-relay.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "AI-Agent-Office-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "AI-Agent-Office-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AI Agent Office"
    }
  },
  "dependencies": {
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "prettier": "3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
